# ============================================================
# 后端环境变量示例
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 按实际情况修改 .env（重点填数据库密码）
#   3. .env 已写入 .gitignore，不会提交，可放心填写真实密码
# ============================================================

# ---- 数据库连接（必填）----
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<数据库名>
DATABASE_URL=mysql+pymysql://root:你的MySQL密码@localhost:3306/cinema_system

# ---- 文件上传（可选，不填则使用代码内置默认值）----
# 上传文件保存目录（相对 backend 目录）
UPLOAD_DIR=uploads
# 单个文件大小上限（字节），默认 10485760 = 10MB
MAX_UPLOAD_SIZE=10485760

# ---- 跨域 CORS（可选，JSON 数组格式）----
# 允许访问后端的前端来源
CORS_ORIGINS=["http://localhost","http://localhost:8080","http://localhost:3000"]
